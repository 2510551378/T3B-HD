# Publish only reviewed source roots. All other workspace data stays local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CONTRIBUTING.md
!/THIRD_PARTY_NOTICES.md
!/requirements.txt
!/.github/
!/docs/
!/scripts/
!/work/
/work/*
!/work/psp_parse/
!/work/t3b_hd/
!/work/t3b_unreal/

/work/psp_parse/*
!/work/psp_parse/README.md
!/work/psp_parse/tools/
!/work/psp_parse/docs/
!/work/psp_parse/archive/
/work/psp_parse/archive/*.txt

/work/t3b_hd/*
!/work/t3b_hd/README.md
!/work/t3b_hd/REMASTER_PLAN.md
!/work/t3b_hd/Makefile.win
!/work/t3b_hd/run_m1_hd_sampling.ps1
!/work/t3b_hd/src/
!/work/t3b_hd/tools/
!/work/t3b_hd/docs/

/work/t3b_unreal/*
!/work/t3b_unreal/README.md
!/work/t3b_unreal/*.uproject
!/work/t3b_unreal/Config/
!/work/t3b_unreal/Source/
!/work/t3b_unreal/Shaders/
!/work/t3b_unreal/Tools/

# Generated files, secrets, binaries and local editor state, even in source roots.
**/__pycache__/
**/.venv/
**/node_modules/
**/Binaries/
**/Intermediate/
**/Saved/
**/DerivedDataCache/
**/build/
**/.vs/
**/.idea/
**/.vscode/
*.pyc
*.pyo
*.exe
*.dll
*.obj
*.o
*.lib
*.a
*.pdb
*.ilk
*.sln
*.suo
*.user
*.vcxproj*
*.log
*.csv
*.bin
*.iso
*.cso
*.pbp
*.prx
*.elf
*.ppst
*.ppdmp
*.uasset
*.umap
*.pak
*.pem
*.key
.env
.env.*
/work/t3b_unreal/Tools/source_core_verification.json
